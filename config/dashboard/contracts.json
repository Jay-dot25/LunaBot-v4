  "write_contract": {
    "topic_types": {"/lunabot/dashboard/command_request":"std_msgs/msg/String","/lunabot/mission/command":"std_msgs/msg/String"},
    "allowed_mission_commands": ["PAUSE","RESUME","CANCEL","RECOVER","ESTOP","RESET_ESTOP","DELIVER <delivery-id>"],
    "service_types": {"/lunabot/safety/emergency_stop":"std_srvs/srv/Trigger","/lunabot/safety/reset":"std_srvs/srv/Trigger","/lunabot/safety/arm_startup":"std_srvs/srv/Trigger"},
    "require_fresh_mission_status_seconds": 1.5,
    "require_fresh_safety_health_seconds": 0.5,
    "velocity_publish_allowed": false,
    "forbidden_write_topics": ["/cmd_vel","/cmd_vel_in","/lunabot/actuator_request","/world/lunar_world/pose/info"],
    "operational_truth_access": false
  },
  "telemetry_contract": {
    "keep_original_header_stamps": true,
    "map_and_plan_frame": "map",
    "attach_monotonic_receive_time": true,
    "show_age_and_fresh_stale_unknown": true,
    "sensor_stamp_age_limit_sim_seconds": 0.25,
    "sensor_rates_hz": {"/lunabot/camera/image_raw":20,"/lunabot/depth/image_raw":15,"/lunabot/lidar/scan":10,"/lunabot/imu":100,"/lunabot/odom":30},
    "notes": "Configured sensor rates and 0.25s age are initial diagnostics contracts, not live guarantees for every launch profile. Use simulation stamps for sensor age and local monotonic receive times for dashboard render age."
  }
