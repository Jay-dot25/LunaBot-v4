<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lunar_world">
    
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -300 200 0 0.55 1.57</pose>
        <clip>
          <near>1.0</near>
          <far>5000.0</far>
        </clip>
      </camera>
    </gui>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Airless lunar sky: the directional light is the only direct source. -->
    <scene>
      <ambient>0.025 0.025 0.03 1</ambient>
      <background>0 0 0 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    
    <gravity>0 0 -1.62</gravity>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    
    <!-- Required for entity spawning (ign service -s /world/lunar_world/create) -->
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <!-- Fortress requires the world IMU system plugin for <sensor type="imu">. -->
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 200 0 0 0</pose>
      <diffuse>1.0 0.97 0.90 1</diffuse>
      <specular>0.16 0.15 0.13 1</specular>
      <direction>-0.48 0.36 -0.80</direction>
    </light>

    <!-- ================= LUNAR TERRAIN =================
         Generated by tools/generate_lunar_terrain.py (deterministic, seed 42).
         - Visual mesh:  320x320 grid, 1.25 m, per-vertex grey albedo (~16 MB)
         - Collision mesh: 100x100 grid, 4 m (~1.2 MB, fast physics)
         file:// URIs resolve against GZ_SIM_RESOURCE_PATH / IGN_GAZEBO_RESOURCE_PATH,
         which launch-a.sh sets to this directory (src/lunabot_gazebo/worlds).
    -->
    <model name="lunar_terrain">
      <static>true</static>
      <link name="terrain_link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file://meshes/lunar_terrain_collision.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <!-- Higher-resolution collision patch over the bounded mission area.
             It uses the same world-frame terrain samples and supplements the
             coarse 4 m mesh for local rover planning and contact. -->
        <collision name="mission_detail_collision">
          <geometry>
            <mesh>
              <uri>file://meshes/lunar_terrain_mission_collision.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file://meshes/lunar_terrain.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.085 1</ambient>
            <diffuse>0.58 0.58 0.57 1</diffuse>
            <specular>0.025 0.025 0.025 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= TRAINED-CLASS NAVIGATION OBSTACLES =================
         Keep the generated 400 m terrain and its collision mesh untouched.
         Local obstacles use only the active model's supported visual classes:
         rock, shadowed crater, and regolith. Placement leaves broad routes
         around each feature inside the +/- 7 m random-goal test region.
    -->
    <model name="presentation_obstacle_forward">
      <static>true</static>
      <pose>2.25 0.05 -2.7383 0 0 0</pose>
      <link name="rock_cluster">
        <collision name="obstacle_collision"><pose>0 0 0 0 0 0</pose><geometry><sphere><radius>0.42</radius></sphere></geometry></collision>
        <collision name="rock_small_collision"><pose>0.43 0.23 0.08 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry></collision>
        <collision name="rock_flake_collision"><pose>-0.32 -0.25 0.04 0 0 0</pose><geometry><sphere><radius>0.18</radius></sphere></geometry></collision>
        <visual name="rock_large"><pose>0 0 0 0 0 0</pose><geometry><sphere><radius>0.42</radius></sphere></geometry><material><ambient>0.10 0.105 0.11 1</ambient><diffuse>0.24 0.25 0.26 1</diffuse><specular>0.025 0.025 0.025 1</specular></material></visual>
        <visual name="rock_small"><pose>0.43 0.23 0.08 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>0.10 0.105 0.11 1</ambient><diffuse>0.24 0.25 0.26 1</diffuse></material></visual>
        <visual name="rock_flake"><pose>-0.32 -0.25 0.04 0 0 0</pose><geometry><sphere><radius>0.18</radius></sphere></geometry><material><ambient>0.10 0.105 0.11 1</ambient><diffuse>0.24 0.25 0.26 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Deterministic obstacle for the Phase L demo mission. The bounded
         acceptance starts at world x=5.5 m and targets 1.5 metres forward.
         Keep the rock just off the goal centerline so it remains observable to
         LiDAR without occupying the bounded demo goal cell. Center the sphere
         one radius above the terrain datum so it rests on the ground. -->
    <model name="mission_replan_rock">
      <static>true</static>
      <pose>8.0 1.2 -2.3683 0 0 0</pose>
      <link name="rock">
        <collision name="rock_collision">
          <geometry><sphere><radius>0.42</radius></sphere></geometry>
        </collision>
        <visual name="rock_visual">
          <geometry><sphere><radius>0.42</radius></sphere></geometry>
          <material>
            <ambient>0.10 0.105 0.11 1</ambient>
            <diffuse>0.24 0.25 0.26 1</diffuse>
            <specular>0.025 0.025 0.025 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="trained_rock_cluster_north">
      <static>true</static>
      <pose>2.1 3.55 -2.7383 0 0 0</pose>
      <link name="rock_cluster">
        <collision name="rock_collision"><geometry><sphere><radius>0.34</radius></sphere></geometry></collision>
        <visual name="rock_visual"><geometry><sphere><radius>0.34</radius></sphere></geometry><material><ambient>0.09 0.095 0.10 1</ambient><diffuse>0.21 0.22 0.23 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
      </link>
    </model>

    <model name="trained_regolith_mound_southeast">
      <static>true</static>
      <pose>4.4 -2.65 -3.1683 0 0 0</pose>
      <link name="regolith_mound">
        <collision name="mound_collision"><geometry><sphere><radius>0.58</radius></sphere></geometry></collision>
        <visual name="mound_visual"><geometry><sphere><radius>0.58</radius></sphere></geometry><material><ambient>0.22 0.215 0.20 1</ambient><diffuse>0.48 0.46 0.42 1</diffuse><specular>0.015 0.015 0.015 1</specular></material></visual>
        <visual name="mound_ripple_1"><pose>0.10 0 0.12 0 0.10 0</pose><geometry><box><size>0.64 0.018 0.012</size></box></geometry><material><ambient>0.27 0.26 0.24 1</ambient><diffuse>0.50 0.48 0.44 1</diffuse></material></visual>
        <visual name="mound_ripple_2"><pose>-0.08 0.03 0.19 0 -0.12 0.35</pose><geometry><box><size>0.48 0.014 0.01</size></box></geometry><material><ambient>0.27 0.26 0.24 1</ambient><diffuse>0.50 0.48 0.44 1</diffuse></material></visual>
      </link>
    </model>

    <model name="trained_regolith_mound_west">
      <static>true</static>
      <pose>-3.5 -1.6 -3.1883 0 0 0</pose>
      <link name="regolith_mound">
        <collision name="mound_collision"><geometry><sphere><radius>0.52</radius></sphere></geometry></collision>
        <visual name="mound_visual"><geometry><sphere><radius>0.52</radius></sphere></geometry><material><ambient>0.22 0.215 0.20 1</ambient><diffuse>0.47 0.45 0.41 1</diffuse><specular>0.015 0.015 0.015 1</specular></material></visual>
      </link>
    </model>

    <model name="trained_crater_shadow_northeast">
      <static>true</static>
      <pose>5.15 4.15 -2.7883 0 0 0</pose>
      <link name="shadowed_crater">
        <visual name="dark_crater_floor"><pose>0 0 0.006 0 0 0</pose><geometry><cylinder><radius>0.78</radius><length>0.012</length></cylinder></geometry><material><ambient>0.002 0.002 0.003 1</ambient><diffuse>0.012 0.012 0.015 1</diffuse><specular>0 0 0 1</specular></material></visual>
        <collision name="crater_rim_00"><pose>0.98 0 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <collision name="crater_rim_01"><pose>0.849 0.49 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <collision name="crater_rim_02"><pose>0.49 0.849 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <collision name="crater_rim_03"><pose>0 0.98 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <collision name="crater_rim_04"><pose>-0.49 0.849 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <collision name="crater_rim_05"><pose>-0.849 0.49 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <collision name="crater_rim_06"><pose>-0.98 0 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <collision name="crater_rim_07"><pose>-0.849 -0.49 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <collision name="crater_rim_08"><pose>-0.49 -0.849 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <collision name="crater_rim_09"><pose>0 -0.98 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <collision name="crater_rim_10"><pose>0.49 -0.849 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <collision name="crater_rim_11"><pose>0.849 -0.49 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry></collision>
        <visual name="crater_rim_visual_00"><pose>0.98 0 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="crater_rim_visual_01"><pose>0.849 0.49 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="crater_rim_visual_02"><pose>0.49 0.849 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="crater_rim_visual_03"><pose>0 0.98 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="crater_rim_visual_04"><pose>-0.49 0.849 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="crater_rim_visual_05"><pose>-0.849 0.49 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="crater_rim_visual_06"><pose>-0.98 0 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="crater_rim_visual_07"><pose>-0.849 -0.49 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="crater_rim_visual_08"><pose>-0.49 -0.849 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="crater_rim_visual_09"><pose>0 -0.98 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="crater_rim_visual_10"><pose>0.49 -0.849 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
        <visual name="crater_rim_visual_11"><pose>0.849 -0.49 0.07 0 0 0</pose><geometry><sphere><radius>0.24</radius></sphere></geometry><material><ambient>0.06 0.06 0.062 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= LUNAR HABITAT PRESENTATION =================
         Small, static habitat modules sit clear of the rover's short demo
         corridor. Their collisions are real; panels and windows are visual. -->
    <!-- The habitat body collision and visual both start at local z=0.
         Anchor the module base to the sampled terrain height at this site. -->
    <model name="lunar_habitat_main">
      <static>true</static>
      <pose>-5.2 -4.0 -3.1516 0 0 0</pose>
      <link name="habitat_pressure_module">
        <collision name="habitat_body_collision">
          <pose>0 0 0.62 0 0 0</pose>
          <geometry><box><size>2.0 1.7 1.24</size></box></geometry>
        </collision>
        <collision name="habitat_dome_collision">
          <pose>0 0 1.38 0 0 0</pose>
          <geometry><sphere><radius>0.72</radius></sphere></geometry>
        </collision>
        <visual name="habitat_body">
          <pose>0 0 0.62 0 0 0</pose>
          <geometry><box><size>2.0 1.7 1.24</size></box></geometry>
          <material><ambient>0.38 0.39 0.40 1</ambient><diffuse>0.72 0.73 0.72 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>
        <visual name="habitat_dome">
          <pose>0 0 1.28 0 0 0</pose>
          <geometry><sphere><radius>0.70</radius></sphere></geometry>
          <material><ambient>0.30 0.34 0.36 1</ambient><diffuse>0.52 0.58 0.60 1</diffuse><specular>0.24 0.24 0.24 1</specular></material>
        </visual>
        <visual name="habitat_viewport">
          <pose>0 -0.858 0.80 0 0 0</pose>
          <geometry><box><size>0.68 0.025 0.42</size></box></geometry>
          <material><ambient>0.02 0.06 0.08 1</ambient><diffuse>0.05 0.16 0.22 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
        </visual>
        <visual name="habitat_airlock">
          <pose>1.12 0 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.30</radius><length>0.90</length></cylinder></geometry>
          <material><ambient>0.28 0.29 0.30 1</ambient><diffuse>0.57 0.58 0.57 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The equipment base also starts at local z=0; its panels and mast are
         attached above it. Set the base on the local terrain surface. -->
    <model name="lunar_habitat_equipment">
      <static>true</static>
      <pose>-2.9 -4.2 -3.0601 0 0 0</pose>
      <link name="habitat_equipment">
        <collision name="equipment_base_collision">
          <pose>0 0 0.36 0 0 0</pose>
          <geometry><box><size>0.90 0.76 0.72</size></box></geometry>
        </collision>
        <visual name="equipment_base">
          <pose>0 0 0.36 0 0 0</pose>
          <geometry><box><size>0.90 0.76 0.72</size></box></geometry>
          <material><ambient>0.25 0.22 0.18 1</ambient><diffuse>0.54 0.46 0.35 1</diffuse></material>
        </visual>
        <visual name="solar_panel_left">
          <pose>-0.92 0 0.82 0 0.12 -0.20</pose>
          <geometry><box><size>0.92 0.06 0.76</size></box></geometry>
          <material><ambient>0.025 0.07 0.16 1</ambient><diffuse>0.05 0.20 0.42 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
        </visual>
        <visual name="solar_panel_right">
          <pose>0.92 0 0.82 0 0.12 0.20</pose>
          <geometry><box><size>0.92 0.06 0.76</size></box></geometry>
          <material><ambient>0.025 0.07 0.16 1</ambient><diffuse>0.05 0.20 0.42 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
        </visual>
        <visual name="antenna_mast">
          <pose>0 0.26 1.10 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.82</length></cylinder></geometry>
          <material><ambient>0.60 0.60 0.57 1</ambient><diffuse>0.78 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= HORIZON CATCH PLANE =================
         Keeps the world from ending in a void if the rover drives beyond the
         terrain mesh edge (400 m x 400 m crater field). Sits ~3 m below the
         lowest crater floor, so it is never visible inside the crater field.
    -->
    <model name="lunar_horizon">
      <static>true</static>
      <link name="horizon_link">
        <collision name="horizon_collision">
          <pose>0 0 -12.4 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <center>800 800</center>
            </plane>
          </geometry>
        </collision>
        <visual name="horizon_visual">
          <pose>0 0 -12.4 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <center>800 800</center>
            </plane>
          </geometry>
          <material>
            <ambient>0.42 0.42 0.42 1</ambient>
            <diffuse>0.42 0.42 0.42 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
